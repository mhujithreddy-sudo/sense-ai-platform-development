# =============================================================
# SENSE — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in the real values.
#
#   cp .env.example .env.local
#
# NEVER commit .env.local to version control.
# =============================================================

# Your Supabase project URL (found in Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Your Supabase **anon / publishable** key (starts with eyJ... or sb_publishable_...)
# ⚠️  DO NOT use the service_role / secret key here.
#     The secret key starts with sb_secret_ and must NEVER appear
#     in any NEXT_PUBLIC_ variable or browser-side code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...YOUR_ANON_KEY_HERE
